# ---- Portal -------------------------------------------------------------
# Public address of this portal (used in e-mail links). No trailing slash.
BASE_URL=https://wp-portal.example.org
# Long random string; signs the approval links. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Where the SQLite database, uploaded PDFs and the dev-mode outbox live.
DATA_DIR=./data
# Optional shared code colleagues must type to submit (leave empty to disable).
SUBMIT_CODE=
# Basic-auth credentials for the /admin page.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Days an approval link stays valid (the /admin page can always mint a new one).
TOKEN_MAX_AGE_DAYS=30
# Upload limit for the PDF, in megabytes.
MAX_PDF_MB=50

# ---- RePEc archive ------------------------------------------------------
ARCHIVE_CODE=nwc
SERIES_CODE=wpaper
SERIES_NAME=Newcastle Economics Discussion Papers
# Public URL of the GitHub Pages site that serves the archive. No trailing slash.
SITE_URL=https://ncl-economics.github.io
# Directories (inside the repo) holding the paper templates and the PDFs.
RDF_DIR=RePEc/nwc/wpaper
PDF_DIR=papers
# File-name patterns; placeholders: {archive} {series} {year} {number}
RDF_FILE_PATTERN={archive}{year}.rdf
PDF_FILE_PATTERN={number}.pdf
# Paper numbers look like 2026-01; the width is the number of digits.
NUMBER_WIDTH=2
# Default affiliation suggested on the form.
DEFAULT_WORKPLACE=Newcastle University Business School
# Command run on the PDF before publishing, to add the series cover page.
# Placeholders: {input} {output} {meta} (JSON with title/authors/number/date)
# {number} {title} {authors} {date}. Leave empty to publish the PDF as uploaded.
COVER_COMMAND=python3 ../tools/make_cover.py {input} {output} --meta {meta}

# ---- GitHub (archive repository) ----------------------------------------
# Fine-grained personal access token with "Contents: read and write" on the repo.
GITHUB_TOKEN=
GITHUB_REPO=ncl-economics/ncl-economics.github.io
GITHUB_BRANCH=main

# ---- E-mail -------------------------------------------------------------
# Leave SMTP_HOST empty to write e-mails to DATA_DIR/outbox instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
MAIL_FROM=Working Paper Portal <noreply@example.org>
# Who approves submissions (receives the review link).
ADMIN_EMAIL=francesco.fusari@newcastle.ac.uk
# Marketing & Communication contact(s), comma-separated.
MARKETING_EMAILS=marketing@example.org
